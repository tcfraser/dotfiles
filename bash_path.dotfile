# Extra path locations added on top of windows and cygwin

export PATH="~/Programs/Sublime Text 3/":$PATH # For subl.exe
alias scipython="~/Packages/SciPython/WinPython-64bit-3.4.3.7/python-3.4.3.amd64/python.exe -u"
alias scipython3="~/Packages/SciPython/WinPython-64bit-3.4.3.7/python-3.4.3.amd64/python.exe -u"
export PYTHONIOENCODING="utf-8"
alias scipython2="~/Packages/SciPython/WinPython-64bit-2.7.10.3/python-2.7.10.amd64/python.exe -u"
export PATH="/bin/rubygems/bin":$PATH # For ruby gems like jekyll
# export VS90COMNTOOLS="/cygdrive/c/Users/TC/AppData/Local/Programs/Common/Microsoft/Visual\ C++\ for\ Python/9.0/VC/bin/"