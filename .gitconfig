[push]
    default = simple
[user]
    email = tcfraser237@gmail.com
    name = TC Fraser
[alias]
    st = status
    co = checkout
    ci = commit
    br = branch
    df = diff
    ad = add

    go = "!f() { git add -u . && git add . && git commit -m \"$1\" && git pull && git push; }; f"
[color]
    ui = auto
[help]
    autocorrect = 1
[init]
    defaultBranch = main
[credential "https://github.com"]
    helper = !/home/linuxbrew/.linuxbrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
    helper = !/home/linuxbrew/.linuxbrew/bin/gh auth git-credential
